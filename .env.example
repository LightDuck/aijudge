DATABASE_URL=postgresql://aijudge:aijudge@localhost:5433/aijudge
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Local $0-cost LLM via Ollama (https://ollama.com), running Qwen3-8B.
# `python -m aijudge` uses this by default. Defaults shown below;
# only set these if Ollama runs elsewhere or you want a different model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
