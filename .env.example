DATABASE_URL=postgresql://aijudge:aijudge@localhost:5433/aijudge
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# `python -m aijudge` uses Claude (ANTHROPIC_API_KEY above) for the LLM and
# local Ollama (https://ollama.com, running all-minilm) for embeddings, $0
# extra cost on top of the Claude API. Defaults shown below; only set these
# if Ollama runs elsewhere or you want a different embedding model.
# OLLAMA_MODEL is unused by the default wiring (kept for real-Ollama-LLM
# tests/scripts that construct OllamaLLMClient directly).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=all-minilm
# HTTP API (`python -m aijudge.api`). Defaults shown below; only set these to
# bind elsewhere, change the port, or allow a frontend dev server origin other
# than the two allowed by default (localhost:3000, localhost:5173).
AIJUDGE_API_HOST=127.0.0.1
AIJUDGE_API_PORT=8000
AIJUDGE_API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
