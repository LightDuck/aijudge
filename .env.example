DATABASE_URL=postgresql://aijudge:aijudge@localhost:5433/aijudge
# Separate database for the test suite: DB tests truncate tables, so they
# only run against this one (and skip when it's unset), never DATABASE_URL.
TEST_DATABASE_URL=postgresql://aijudge:aijudge@localhost:5433/aijudge_test
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# `python -m aijudge` and `python -m aijudge.api` both use local Ollama
# (https://ollama.com) for the LLM (OLLAMA_MODEL, default qwen3:8b) and
# embeddings (OLLAMA_EMBEDDING_MODEL, default all-minilm), $0 cost, no API
# key. Defaults shown below; only set these if Ollama runs elsewhere or you
# want different models. ANTHROPIC_API_KEY/OPENAI_API_KEY above are only
# needed for the alternate hosted wiring in entrypoint.py (used for its own
# embeddings, and by scripts/tests that construct AnthropicLLMClient
# directly).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=all-minilm
# HTTP API (`python -m aijudge.api`). Defaults shown below; only set these to
# bind elsewhere, change the port, or allow a frontend dev server origin other
# than the two allowed by default (localhost:3000, localhost:5173).
AIJUDGE_API_HOST=127.0.0.1
AIJUDGE_API_PORT=8000
AIJUDGE_API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
